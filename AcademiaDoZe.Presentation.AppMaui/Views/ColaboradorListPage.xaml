<?xml version="1.0" encoding="utf-8" ?>
<!-- Ana Luisa Ribeiro de Araujo -->

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:AcademiaDoZe.Presentation.AppMaui.ViewModels"
    xmlns:dto="clr-namespace:AcademiaDoZe.Application.DTOs;assembly=AcademiaDoZe.Application"
    x:Class="AcademiaDoZe.Presentation.AppMaui.Views.ColaboradorListPage"
    x:DataType="vm:ColaboradorListViewModel"
    Title="Colaboradores"
    BackgroundColor="#F5F5F5">

    <Grid Padding="20"
          RowDefinitions="Auto,Auto,Auto,*"
          RowSpacing="12">

        <!-- Título -->
        <Label
            Grid.Row="0"
            Text="Colaboradores"
            FontSize="28"
            FontAttributes="Bold"
            TextColor="#171717" />

        <!-- Botão de cadastro -->
        <Button
            Grid.Row="1"
            Text="+ Novo colaborador"
            BackgroundColor="#39FF14"
            TextColor="#171717"
            FontAttributes="Bold"
            CornerRadius="10"
            Command="{Binding NovoColaboradorCommand}" />

        <!-- Pesquisa -->
        <SearchBar
            Grid.Row="2"
            Placeholder="Pesquisar colaborador..."
            Text="{Binding SearchText}"
            SearchCommand="{Binding PesquisarCommand}"
            BackgroundColor="#FFFFFF"
            TextColor="#171717"
            PlaceholderColor="#777777"
            CancelButtonColor="#39FF14" />

        <!-- Filtro e lista -->
        <Grid Grid.Row="3"
              RowDefinitions="Auto,*"
              RowSpacing="8">

            <Picker
                Grid.Row="0"
                Title="Filtrar por"
                ItemsSource="{Binding FilterTypes}"
                SelectedItem="{Binding SelectedFilterType}"
                BackgroundColor="#FFFFFF"
                TextColor="#171717"
                TitleColor="#666666" />

            <CollectionView
                Grid.Row="1"
                ItemsSource="{Binding Colaboradores}"
                SelectionMode="Single"
                SelectedItem="{Binding SelectedColaborador}">

                <CollectionView.EmptyView>
                    <VerticalStackLayout
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        Spacing="8">

                        <Label
                            Text="Nenhum colaborador encontrado."
                            FontSize="16"
                            TextColor="#555555"
                            HorizontalTextAlignment="Center" />

                        <Label
                            Text="Cadastre um colaborador ou altere a pesquisa."
                            FontSize="13"
                            TextColor="#777777"
                            HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="dto:ColaboradorDto">

                        <Border
                            Padding="16"
                            Margin="0,4"
                            BackgroundColor="#FFFFFF"
                            Stroke="#E0E0E0"
                            StrokeThickness="1">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>

                            <VerticalStackLayout Spacing="7">

                                <Label
                                    Text="{Binding Nome}"
                                    FontSize="19"
                                    FontAttributes="Bold"
                                    TextColor="#171717" />

                                <Label
                                    Text="{Binding Cpf, StringFormat='CPF: {0}'}"
                                    FontSize="14"
                                    TextColor="#333333" />

                                <Label
                                    Text="{Binding Email, StringFormat='E-mail: {0}'}"
                                    FontSize="14"
                                    TextColor="#333333" />

                                <Label
                                    Text="{Binding Tipo, StringFormat='Tipo: {0}'}"
                                    FontSize="14"
                                    TextColor="#333333" />

                                <Label
                                    Text="{Binding Vinculo, StringFormat='Vínculo: {0}'}"
                                    FontSize="14"
                                    TextColor="#333333" />

                                <Label
                                    Text="Clique no cadastro para editar"
                                    FontSize="12"
                                    TextColor="#39FF14"
                                    Margin="0,4,0,0" />

                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>
        </Grid>
    </Grid>
</ContentPage>
