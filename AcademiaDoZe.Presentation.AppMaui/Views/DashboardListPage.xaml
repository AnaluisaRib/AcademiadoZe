<?xml version="1.0" encoding="utf-8" ?>
<!-- Ana Luisa Ribeiro de Araujo -->

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="AcademiaDoZe.Presentation.AppMaui.Views.DashboardListPage"
    xmlns:vm="clr-namespace:AcademiaDoZe.Presentation.AppMaui.ViewModels"
    x:DataType="vm:DashboardListViewModel"
    Title="Academia do Zé"
    BackgroundColor="#0B0B0B">

    <ScrollView>

        <VerticalStackLayout
            Spacing="0"
            Padding="20,25,20,30">

            <!-- LOGO -->
            <Border
                BackgroundColor="#111111"
                Stroke="#39FF14"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 20"
                Padding="15"
                Margin="0,0,0,20">

                <VerticalStackLayout
                    Spacing="8"
                    HorizontalOptions="Center">

                    <Image
                        Source="academiadoze.png"
                        HeightRequest="190"
                        WidthRequest="190"
                        Aspect="AspectFit"
                        HorizontalOptions="Center"/>

                    <Label
                        Text="Sistema de Gerenciamento"
                        TextColor="#BDBDBD"
                        FontSize="14"
                        HorizontalTextAlignment="Center"/>

                    <Label
                        Text="Ana Luisa Ribeiro de Araujo"
                        TextColor="#39FF14"
                        FontSize="13"
                        FontAttributes="Bold"
                        HorizontalTextAlignment="Center"/>

                </VerticalStackLayout>

            </Border>


            <!-- TÍTULO -->
            <VerticalStackLayout
                Spacing="4"
                Margin="0,0,0,20">

                <Label
                    Text="Dashboard"
                    TextColor="White"
                    FontSize="28"
                    FontAttributes="Bold"/>

                <Label
                    Text="Visão geral da Academia do Zé"
                    TextColor="#999999"
                    FontSize="14"/>

            </VerticalStackLayout>


            <!-- CARDS -->
            <Grid
                ColumnDefinitions="*,*"
                RowDefinitions="Auto,Auto"
                ColumnSpacing="12"
                RowSpacing="12">


                <!-- LOGRADOUROS -->
                <Border
                    Grid.Row="0"
                    Grid.Column="0"
                    BackgroundColor="#151515"
                    Stroke="#39FF14"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 16"
                    Padding="15">

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer
                            Command="{Binding NavigateToLogradourosCommand}"/>
                    </Border.GestureRecognizers>

                    <VerticalStackLayout
                        Spacing="8">

                        <Label
                            Text="📍"
                            FontSize="25"/>

                        <Label
                            Text="{Binding TotalLogradouros}"
                            TextColor="#39FF14"
                            FontSize="30"
                            FontAttributes="Bold"/>

                        <Label
                            Text="Logradouros"
                            TextColor="White"
                            FontSize="14"/>

                    </VerticalStackLayout>

                </Border>


                <!-- ALUNOS -->
                <Border
                    Grid.Row="0"
                    Grid.Column="1"
                    BackgroundColor="#151515"
                    Stroke="#2C2C2C"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 16"
                    Padding="15">

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer
                            Command="{Binding NavigateToAlunosCommand}"/>
                    </Border.GestureRecognizers>

                    <VerticalStackLayout
                        Spacing="8">

                        <Label
                            Text="👤"
                            FontSize="25"/>

                        <Label
                            Text="{Binding TotalAlunos}"
                            TextColor="#39FF14"
                            FontSize="30"
                            FontAttributes="Bold"/>

                        <Label
                            Text="Alunos"
                            TextColor="White"
                            FontSize="14"/>

                    </VerticalStackLayout>

                </Border>


                <!-- COLABORADORES -->
                <Border
                    Grid.Row="1"
                    Grid.Column="0"
                    BackgroundColor="#151515"
                    Stroke="#2C2C2C"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 16"
                    Padding="15">

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer
                            Command="{Binding NavigateToColaboradoresCommand}"/>
                    </Border.GestureRecognizers>

                    <VerticalStackLayout
                        Spacing="8">

                        <Label
                            Text="💼"
                            FontSize="25"/>

                        <Label
                            Text="{Binding TotalColaboradores}"
                            TextColor="#39FF14"
                            FontSize="30"
                            FontAttributes="Bold"/>

                        <Label
                            Text="Colaboradores"
                            TextColor="White"
                            FontSize="14"/>

                    </VerticalStackLayout>

                </Border>


                <!-- MATRÍCULAS -->
                <Border
                    Grid.Row="1"
                    Grid.Column="1"
                    BackgroundColor="#151515"
                    Stroke="#2C2C2C"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 16"
                    Padding="15">

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer
                            Command="{Binding NavigateToMatriculasCommand}"/>
                    </Border.GestureRecognizers>

                    <VerticalStackLayout
                        Spacing="8">

                        <Label
                            Text="📋"
                            FontSize="25"/>

                        <Label
                            Text="{Binding TotalMatriculas}"
                            TextColor="#39FF14"
                            FontSize="30"
                            FontAttributes="Bold"/>

                        <Label
                            Text="Matrículas"
                            TextColor="White"
                            FontSize="14"/>

                    </VerticalStackLayout>

                </Border>

            </Grid>


            <!-- ACESSO A LOGRADOUROS -->
            <Border
                BackgroundColor="#39FF14"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 16"
                Padding="18"
                Margin="0,25,0,0">

                <Border.GestureRecognizers>
                    <TapGestureRecognizer
                        Command="{Binding NavigateToLogradourosCommand}"/>
                </Border.GestureRecognizers>

                <Grid ColumnDefinitions="Auto,*"
                      ColumnSpacing="12">

                    <Label
                        Text="📍"
                        FontSize="24"
                        VerticalOptions="Center"/>

                    <VerticalStackLayout
                        Grid.Column="1"
                        Spacing="2">

                        <Label
                            Text="Gerenciar Logradouros"
                            TextColor="#000000"
                            FontSize="16"
                            FontAttributes="Bold"/>

                        <Label
                            Text="Cadastrar, editar e excluir"
                            TextColor="#1A1A1A"
                            FontSize="12"/>

                    </VerticalStackLayout>

                </Grid>

            </Border>


            <!-- CARREGANDO -->
            <ActivityIndicator
                IsVisible="{Binding IsBusy}"
                IsRunning="{Binding IsBusy}"
                Color="#39FF14"
                HorizontalOptions="Center"
                Margin="0,20,0,0"/>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>