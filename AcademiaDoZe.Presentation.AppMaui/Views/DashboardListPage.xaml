<?xml version="1.0" encoding="utf-8" ?>
<!-- Ana Luisa Ribeiro de Araujo -->

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="AcademiaDoZe.Presentation.AppMaui.Views.DashboardListPage"
    xmlns:vm="clr-namespace:AcademiaDoZe.Presentation.AppMaui.ViewModels"
    x:DataType="vm:DashboardListViewModel"
    Title="Academia do Zé">

    <ScrollView>

        <VerticalStackLayout
            Spacing="0"
            Padding="20,25,20,35">

            <!-- CABEÇALHO -->
            <Grid
                ColumnDefinitions="Auto,*"
                ColumnSpacing="15"
                Margin="0,0,0,30">

                <Border
                    Grid.Column="0"
                    WidthRequest="62"
                    HeightRequest="62"
                    BackgroundColor="{StaticResource Surface}"
                    Stroke="{StaticResource Border}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 18"
                    Padding="10"
                    VerticalOptions="Center">

                    <Image
                        Source="academiadoze.png"
                        Aspect="AspectFit" />

                </Border>

                <VerticalStackLayout
                    Grid.Column="1"
                    VerticalOptions="Center"
                    Spacing="3">

                    <Label
                        Text="Academia do Zé"
                        Style="{StaticResource TitleLabel}"
                        FontSize="24" />

                    <Label
                        Text="Sistema de gerenciamento"
                        Style="{StaticResource SubtitleLabel}" />

                </VerticalStackLayout>

            </Grid>


            <!-- SAUDAÇÃO -->
            <VerticalStackLayout
                Spacing="5"
                Margin="0,0,0,22">

                <Label
                    Text="Olá, Ana Luisa! 👋"
                    TextColor="{StaticResource TextPrimary}"
                    FontSize="26"
                    FontAttributes="Bold" />

                <Label
                    Text="Aqui está um resumo da sua academia."
                    Style="{StaticResource SubtitleLabel}" />

            </VerticalStackLayout>


            <!-- CARDS -->
            <Grid
                ColumnDefinitions="*,*"
                RowDefinitions="Auto,Auto"
                ColumnSpacing="12"
                RowSpacing="12">


                <!-- ALUNOS -->
                <Border
                    Grid.Row="0"
                    Grid.Column="0"
                    Style="{StaticResource HighlightCard}">

                    <VerticalStackLayout
                        Spacing="7">

                        <Label
                            Text="👥"
                            FontSize="22" />

                        <Label
                            Text="{Binding TotalAlunos}"
                            Style="{StaticResource CardNumberLabel}" />

                        <Label
                            Text="Alunos"
                            Style="{StaticResource CardTitleLabel}" />

                        <Label
                            Text="Cadastro de alunos"
                            Style="{StaticResource CardDescriptionLabel}" />

                        <Label
                            Text="Em desenvolvimento"
                            TextColor="{StaticResource TextSecondary}"
                            FontSize="11" />

                    </VerticalStackLayout>

                </Border>


                <!-- MATRÍCULAS -->
                <Border
                    Grid.Row="0"
                    Grid.Column="1"
                    Style="{StaticResource Card}">

                    <VerticalStackLayout
                        Spacing="7">

                        <Label
                            Text="📋"
                            FontSize="22" />

                        <Label
                            Text="{Binding TotalMatriculas}"
                            Style="{StaticResource CardNumberLabel}" />

                        <Label
                            Text="Matrículas"
                            Style="{StaticResource CardTitleLabel}" />

                        <Label
                            Text="Registros de matrícula"
                            Style="{StaticResource CardDescriptionLabel}" />

                        <Label
                            Text="Em desenvolvimento"
                            TextColor="{StaticResource TextSecondary}"
                            FontSize="11" />

                    </VerticalStackLayout>

                </Border>


                <!-- COLABORADORES -->
                <Border
                    Grid.Row="1"
                    Grid.Column="0"
                    Style="{StaticResource Card}">

                    <VerticalStackLayout
                        Spacing="7">

                        <Label
                            Text="💼"
                            FontSize="22" />

                        <Label
                            Text="{Binding TotalColaboradores}"
                            Style="{StaticResource CardNumberLabel}" />

                        <Label
                            Text="Colaboradores"
                            Style="{StaticResource CardTitleLabel}" />

                        <Label
                            Text="Equipe cadastrada"
                            Style="{StaticResource CardDescriptionLabel}" />

                        <Label
                            Text="Em desenvolvimento"
                            TextColor="{StaticResource TextSecondary}"
                            FontSize="11" />

                    </VerticalStackLayout>

                </Border>


                <!-- LOGRADOUROS -->
                <Border
                    Grid.Row="1"
                    Grid.Column="1"
                    Style="{StaticResource HighlightCard}">

                    <Border.GestureRecognizers>

                        <TapGestureRecognizer
                            Command="{Binding NavigateToLogradourosCommand}" />

                    </Border.GestureRecognizers>

                    <VerticalStackLayout
                        Spacing="7">

                        <Label
                            Text="📍"
                            FontSize="22" />

                        <Label
                            Text="{Binding TotalLogradouros}"
                            Style="{StaticResource CardNumberLabel}" />

                        <Label
                            Text="Logradouros"
                            Style="{StaticResource CardTitleLabel}" />

                        <Label
                            Text="Endereços cadastrados"
                            Style="{StaticResource CardDescriptionLabel}" />

                        <Label
                            Text="Clique para gerenciar"
                            TextColor="{StaticResource Primary}"
                            FontSize="11"
                            FontAttributes="Bold" />

                    </VerticalStackLayout>

                </Border>

            </Grid>


            <!-- ACESSO RÁPIDO -->
            <Label
                Text="Acesso rápido"
                Style="{StaticResource SectionTitle}"
                Margin="0,30,0,12" />


            <Border
                Style="{StaticResource HighlightCard}"
                Padding="16">

                <Border.GestureRecognizers>

                    <TapGestureRecognizer
                        Command="{Binding NavigateToLogradourosCommand}" />

                </Border.GestureRecognizers>

                <Grid
                    ColumnDefinitions="Auto,*"
                    ColumnSpacing="15">

                    <Border
                        WidthRequest="48"
                        HeightRequest="48"
                        BackgroundColor="{StaticResource Primary}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 14"
                        Padding="10"
                        VerticalOptions="Center">

                        <Label
                            Text="📍"
                            FontSize="21"
                            HorizontalTextAlignment="Center"
                            VerticalTextAlignment="Center" />

                    </Border>

                    <VerticalStackLayout
                        Grid.Column="1"
                        VerticalOptions="Center"
                        Spacing="3">

                        <Label
                            Text="Gerenciar Logradouros"
                            TextColor="{StaticResource TextPrimary}"
                            FontSize="16"
                            FontAttributes="Bold" />

                        <Label
                            Text="Cadastrar, editar e excluir endereços"
                            Style="{StaticResource CardDescriptionLabel}" />

                    </VerticalStackLayout>

                </Grid>

            </Border>


            <!-- CARREGAMENTO -->
            <ActivityIndicator
                IsVisible="{Binding IsBusy}"
                IsRunning="{Binding IsBusy}"
                Color="{StaticResource Primary}"
                HorizontalOptions="Center"
                Margin="0,25,0,0" />

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>