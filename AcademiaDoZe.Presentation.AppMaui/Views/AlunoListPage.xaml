<?xml version="1.0" encoding="utf-8" ?>
<!-- Ana Luisa Ribeiro de Araujo -->

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:AcademiaDoZe.Presentation.AppMaui.ViewModels"
    xmlns:dto="clr-namespace:AcademiaDoZe.Application.DTOs;assembly=AcademiaDoZe.Application"
    x:Class="AcademiaDoZe.Presentation.AppMaui.Views.AlunoListPage"
    x:DataType="vm:AlunoListViewModel"
    Title="Alunos"
    BackgroundColor="#F5F5F5">

    <Grid Padding="20"
          RowDefinitions="Auto,Auto,Auto,*"
          RowSpacing="12">

        <Label
            Grid.Row="0"
            Text="Alunos"
            FontSize="28"
            FontAttributes="Bold"
            TextColor="#171717" />

        <Button
            Grid.Row="1"
            Text="+ Novo aluno"
            BackgroundColor="#FF7A00"
            TextColor="#171717"
            FontAttributes="Bold"
            CornerRadius="10"
            Command="{Binding NovoAlunoCommand}" />

        <SearchBar
            Grid.Row="2"
            Placeholder="Pesquisar aluno por CPF..."
            Text="{Binding SearchText}"
            SearchCommand="{Binding PesquisarCommand}"
            BackgroundColor="#FFFFFF"
            TextColor="#171717"
            PlaceholderColor="#777777" />

        <CollectionView
            Grid.Row="3"
            ItemsSource="{Binding Alunos}"
            SelectionMode="Single"
            SelectedItem="{Binding SelectedAluno}">

            <CollectionView.EmptyView>
                <Label
                    Text="Nenhum aluno encontrado."
                    TextColor="#555555"
                    FontSize="16"
                    HorizontalTextAlignment="Center"
                    VerticalTextAlignment="Center" />
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="dto:AlunoDto">

                    <Border
                        Padding="16"
                        Margin="0,4"
                        BackgroundColor="#FFFFFF"
                        Stroke="#E0E0E0"
                        StrokeThickness="1">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>

                        <VerticalStackLayout Spacing="7">

                            <Label
                                Text="{Binding Nome}"
                                FontSize="19"
                                FontAttributes="Bold"
                                TextColor="#171717" />

                            <Label
                                Text="{Binding Cpf, StringFormat='CPF: {0}'}"
                                FontSize="14"
                                TextColor="#333333" />

                            <Label
                                Text="{Binding Telefone, StringFormat='Telefone: {0}'}"
                                FontSize="14"
                                TextColor="#333333" />

                            <Label
                                Text="{Binding Email, StringFormat='E-mail: {0}'}"
                                FontSize="14"
                                TextColor="#333333" />

                            <Label
                                Text="Clique no cadastro para editar"
                                FontSize="12"
                                TextColor="#D96800"
                                Margin="0,4,0,0" />

                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>
    </Grid>
</ContentPage>
