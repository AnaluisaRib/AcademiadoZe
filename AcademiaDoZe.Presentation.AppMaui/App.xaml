<Application
    x:Class="AcademiaDoZe.Presentation.AppMaui.App"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Application.Resources>

        <ResourceDictionary>

            <!-- ============================= -->
            <!-- CORES DA APLICAÇÃO -->
            <!-- ============================= -->

            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- ============================= -->
            <!-- ESTILOS LEGADOS / COMPATIBILIDADE -->
            <!-- ============================= -->

            <Style
                TargetType="Label"
                x:Key="Headline">

                <Setter
                    Property="FontSize"
                    Value="28" />

                <Setter
                    Property="FontAttributes"
                    Value="Bold" />

                <Setter
                    Property="HorizontalOptions"
                    Value="Center" />

            </Style>

            <Style
                TargetType="Label"
                x:Key="SubHeadline">

                <Setter
                    Property="FontSize"
                    Value="20" />

                <Setter
                    Property="FontAttributes"
                    Value="Bold" />

                <Setter
                    Property="HorizontalOptions"
                    Value="Center" />

            </Style>

            <Style
                TargetType="Border"
                x:Key="CardBorder">

                <Setter
                    Property="Padding"
                    Value="15" />

                <Setter
                    Property="StrokeThickness"
                    Value="1" />

                <Setter
                    Property="Margin"
                    Value="5" />

            </Style>

            <Style
                TargetType="Button"
                x:Key="ButtonSmall">

                <Setter
                    Property="FontSize"
                    Value="12" />

                <Setter
                    Property="Padding"
                    Value="8,5" />

                <Setter
                    Property="CornerRadius"
                    Value="6" />

            </Style>

        </ResourceDictionary>

    </Application.Resources>

</Application>