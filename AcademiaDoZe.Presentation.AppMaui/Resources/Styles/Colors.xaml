<?xml version="1.0" encoding="UTF-8" ?>
<!-- Ana Luisa Ribeiro de Araujo -->

<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- ============================= -->
    <!-- IDENTIDADE VISUAL - ACADEMIA DO ZÉ -->
    <!-- ============================= -->

    <!-- Verde principal -->
    <Color x:Key="Primary">#39FF14</Color>
    <Color x:Key="PrimaryDark">#27C90F</Color>
    <Color x:Key="PrimaryDarkText">#071007</Color>

    <!-- Verde secundário -->
    <Color x:Key="Secondary">#1FAF45</Color>
    <Color x:Key="SecondaryDarkText">#7CFF96</Color>

    <!-- Verde de destaque -->
    <Color x:Key="Tertiary">#0E7A2A</Color>

    <!-- Cores básicas -->
    <Color x:Key="White">#F5F7F5</Color>
    <Color x:Key="Black">#0B0D0C</Color>

    <!-- Cores da interface -->
    <Color x:Key="MidnightBlue">#0B0D0C</Color>
    <Color x:Key="OffBlack">#101312</Color>

    <!-- Escala de cinza -->
    <Color x:Key="Gray100">#F1F3F2</Color>
    <Color x:Key="Gray200">#D9DEDB</Color>
    <Color x:Key="Gray300">#B8C0BB</Color>
    <Color x:Key="Gray400">#8E9992</Color>
    <Color x:Key="Gray500">#68736C</Color>
    <Color x:Key="Gray600">#454D48</Color>
    <Color x:Key="Gray900">#202522</Color>
    <Color x:Key="Gray950">#141816</Color>

    <!-- Cores específicas da Academia do Zé -->
    <Color x:Key="Background">#0B0D0C</Color>
    <Color x:Key="Surface">#151A17</Color>
    <Color x:Key="SurfaceLight">#1C231F</Color>
    <Color x:Key="Border">#29332D</Color>

    <Color x:Key="TextPrimary">#F5F7F5</Color>
    <Color x:Key="TextSecondary">#9CA69F</Color>

    <Color x:Key="Success">#39FF14</Color>
    <Color x:Key="Warning">#F5C542</Color>
    <Color x:Key="Danger">#FF4D4D</Color>

    <!-- ============================= -->
    <!-- BRUSHES -->
    <!-- ============================= -->

    <SolidColorBrush
        x:Key="PrimaryBrush"
        Color="{StaticResource Primary}" />

    <SolidColorBrush
        x:Key="SecondaryBrush"
        Color="{StaticResource Secondary}" />

    <SolidColorBrush
        x:Key="TertiaryBrush"
        Color="{StaticResource Tertiary}" />

    <SolidColorBrush
        x:Key="WhiteBrush"
        Color="{StaticResource White}" />

    <SolidColorBrush
        x:Key="BlackBrush"
        Color="{StaticResource Black}" />

    <SolidColorBrush
        x:Key="Gray100Brush"
        Color="{StaticResource Gray100}" />

    <SolidColorBrush
        x:Key="Gray200Brush"
        Color="{StaticResource Gray200}" />

    <SolidColorBrush
        x:Key="Gray300Brush"
        Color="{StaticResource Gray300}" />

    <SolidColorBrush
        x:Key="Gray400Brush"
        Color="{StaticResource Gray400}" />

    <SolidColorBrush
        x:Key="Gray500Brush"
        Color="{StaticResource Gray500}" />

    <SolidColorBrush
        x:Key="Gray600Brush"
        Color="{StaticResource Gray600}" />

    <SolidColorBrush
        x:Key="Gray900Brush"
        Color="{StaticResource Gray900}" />

    <SolidColorBrush
        x:Key="Gray950Brush"
        Color="{StaticResource Gray950}" />

    <SolidColorBrush
        x:Key="BackgroundBrush"
        Color="{StaticResource Background}" />

    <SolidColorBrush
        x:Key="SurfaceBrush"
        Color="{StaticResource Surface}" />

    <SolidColorBrush
        x:Key="SurfaceLightBrush"
        Color="{StaticResource SurfaceLight}" />

    <SolidColorBrush
        x:Key="BorderBrush"
        Color="{StaticResource Border}" />

</ResourceDictionary>